}

function prdxSlotAnim(el, finalText) {
    let steps = 25;
    let count = 0;

    let anim = setInterval(() => {
        el.textContent = prdxRandom(finalText.length);
        if (count++ >= steps) {
            clearInterval(anim);
            el.textContent = finalText;
            el.classList.add("glow");
        }
    }, 40);
}

